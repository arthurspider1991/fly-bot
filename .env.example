# ── Telegram (obrigatório) ───────────────────────────────────────────────────
TELEGRAM_TOKEN=coloque_o_token_do_BotFather
ADMIN_CHAT_ID=seu_chat_id_numerico
# username do bot SEM o @ (usado nos links de indicação)
TELEGRAM_BOT_USERNAME=seubot

# ── Mercado Pago (opcional) ──────────────────────────────────────────────────
# Deixe em branco para usar o fluxo manual: o usuário envia o comprovante e o
# admin libera com /liberar. Sem isso, NENHUMA porta HTTP precisa ficar aberta.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Só é usado se MP_ACCESS_TOKEN estiver preenchido. Precisa ser HTTPS público.
MP_WEBHOOK_URL=
# Porta do servidor de webhook (irrelevante enquanto MP estiver desativado).
PORT=8080

# ── Banco ────────────────────────────────────────────────────────────────────
# NÃO edite aqui: o docker-compose.yml força DB_FILE=/data/bot.db (volume).
DB_FILE=/data/bot.db
